# SkillSphere Backend Environment Configuration
PROJECT_NAME="SkillSphere - Career & Job Portal"
VERSION="1.0.0"
SECRET_KEY="skillsphere-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite (Default out of the box)
DATABASE_URL="sqlite:///./skillsphere.db"

# PostgreSQL (Production ready)
# DATABASE_URL="postgresql://skillsphere_user:skillsphere_pass@localhost:5432/skillsphere_db"

UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=10485760
